FROM --platform=$BUILDPLATFORM node:22-alpine AS builder
LABEL org.opencontainers.image.source="https://github.com/xhui999w/nas-dl"
WORKDIR /app
ENV NASFLOW_API_PORT=8888
ENV NASFLOW_INTERNAL_API_URL=http://api:8888
COPY package*.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY app ./app
COPY public ./public
COPY worker ./worker
COPY .openai ./.openai
COPY build ./build
COPY next.config.ts vite.config.ts postcss.config.mjs tsconfig.json ./
RUN npm run build

FROM --platform=$BUILDPLATFORM node:22-alpine AS runtime-deps
ARG TARGETARCH
WORKDIR /deps
COPY package*.json ./
RUN case "${TARGETARCH}" in \
      amd64) npm_arch=x64 ;; \
      arm64) npm_arch=arm64 ;; \
      *) npm_arch="${TARGETARCH}" ;; \
    esac \
    && npm ci --ignore-scripts --no-audit --no-fund \
      --cpu="${npm_arch}" --os=linux --libc=musl

FROM node:22-alpine
LABEL org.opencontainers.image.source="https://github.com/xhui999w/nas-dl"
WORKDIR /app
ENV NASFLOW_API_PORT=8888
ENV NASFLOW_INTERNAL_API_URL=http://api:8888
COPY package*.json ./
COPY --from=runtime-deps /deps/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY app ./app
COPY public ./public
COPY worker ./worker
COPY .openai ./.openai
COPY build ./build
COPY next.config.ts vite.config.ts postcss.config.mjs tsconfig.json ./
EXPOSE 3000
CMD ["npm", "run", "start"]
