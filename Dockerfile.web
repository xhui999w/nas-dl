FROM node:22-alpine
LABEL org.opencontainers.image.source="https://github.com/xhui999w/nas-dl"
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY app ./app
COPY public ./public
COPY worker ./worker
COPY .openai ./.openai
COPY build ./build
COPY next.config.ts vite.config.ts postcss.config.mjs tsconfig.json ./
RUN npm run build
EXPOSE 3000
CMD ["npm", "run", "start"]
